# Copy to `.env` next to compose.yaml and fill in. Never commit the filled-in file.
RUNNER_DOMAIN=runner.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# `docker run --rm shorts-runner generate-key`
SHORTS_RUNNER_MASTER_KEY=
# During a key rotation only: the previous key(s), comma-separated.
SHORTS_RUNNER_OLD_MASTER_KEYS=
# Minutes a publication may be late (the runner was down) before it waits for you; or catch-up.
SHORTS_RUNNER_OVERDUE=15
